PROJECT_NAME="EcoCraft AI"
API_V1_STR="/api"
SECRET_KEY="ecocraft-secret-key-change-in-production-for-jwt"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL="sqlite:///./ecocraft.db"

# Optional Gemini LLM key for enriched craft suggestions
# Application functions 100% locally with computer vision & recommendation engine without this key
GEMINI_API_KEY=""

# Upload directory
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10
